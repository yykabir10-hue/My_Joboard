# Copy to .env and fill in. .env is gitignored - never commit it.
#   cp .env.example .env && chmod 600 .env
#
# Gmail requires an APP PASSWORD (2FA must be on); your normal account password
# is always rejected. Generate one at https://myaccount.google.com/apppasswords

JOBSEARCH_SMTP_HOST=smtp.gmail.com
JOBSEARCH_SMTP_PORT=587
JOBSEARCH_SMTP_USER=you@gmail.com
JOBSEARCH_SMTP_PASSWORD=xxxxxxxxxxxxxxxx
JOBSEARCH_DIGEST_TO=you@gmail.com
